rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isFamilyMember(familyId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/families/$(familyId)) &&
             request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.memberIds;
    }

    function isFamilyAdmin(familyId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/families/$(familyId)) &&
             request.auth.uid == get(/databases/$(database)/documents/families/$(familyId)).data.adminId;
    }

    // Users collection.
    // Quota, billing, referral, identity and family fields are server-owned:
    // anything feeding recalculateStorageLimit() or the payment webhooks
    // (which match buyers by email) must never be client-writable.
    match /users/{userId} {
      allow read: if isOwner(userId);

      // Client-side first-login bootstrap (lib/firebase.ts) — only the free
      // defaults, and the email must be the one Firebase verified.
      allow create: if isOwner(userId) &&
                       request.resource.data.keys().hasOnly([
                         'email', 'displayName', 'avatarUrl', 'settings', 'storageUsed',
                         'storageLimit', 'subscriptionIds', 'role', 'referralCode',
                         'referralCount', 'referralBonusBytes', 'createdAt'
                       ]) &&
                       request.resource.data.email == request.auth.token.email &&
                       request.resource.data.storageUsed == 0 &&
                       request.resource.data.storageLimit == 1073741824 &&
                       request.resource.data.subscriptionIds.size() == 0 &&
                       request.resource.data.role == 'user' &&
                       request.resource.data.referralCount == 0 &&
                       request.resource.data.referralBonusBytes == 0;

      allow update: if isOwner(userId) &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['settings', 'displayName', 'avatarUrl', 'updatedAt']);

      allow delete: if false; // account deletion goes through DELETE /api/users/me
    }

    // Files collection — records are created only by the server (upload
    // confirm validates key ownership and reads the size from storage).
    match /files/{fileId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) ||
        (resource.data.familyId != null && isFamilyMember(resource.data.familyId))
      );

      allow create: if false;

      allow update: if isAuthenticated() &&
                       isOwner(resource.data.userId) &&
                       // Users can only update certain fields
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['name', 'isFavorite', 'isArchived', 'isTrashed', 'trashedAt', 'albumIds', 'updatedAt']);

      allow delete: if isAuthenticated() &&
                       isOwner(resource.data.userId) &&
                       resource.data.isTrashed == true;
    }

    // Albums collection
    match /albums/{albumId} {
      // Public album links are served by the server (/shared/[token]); a
      // client read of `isShared == true` would let anyone list every
      // shared album in the database.
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) ||
        request.auth.uid in resource.data.sharedWith
      );

      allow create: if isAuthenticated() &&
                       isOwner(request.resource.data.userId);

      allow update: if isAuthenticated() &&
                       isOwner(resource.data.userId) &&
                       request.resource.data.userId == resource.data.userId;

      allow delete: if isAuthenticated() &&
                       isOwner(resource.data.userId);
    }

    // Families collection
    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);

      allow create: if isAuthenticated() &&
                       request.resource.data.adminId == request.auth.uid &&
                       request.resource.data.memberIds.hasOnly([request.auth.uid]);

      allow update: if isFamilyAdmin(familyId) &&
                       // Cannot change admin to non-member
                       request.resource.data.adminId in request.resource.data.memberIds &&
                       // Max 5 members
                       request.resource.data.memberIds.size() <= 5;

      allow delete: if isFamilyAdmin(familyId);
    }

    // Subscriptions collection (read-only for users, managed by server)
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() &&
                     isOwner(resource.data.userId);

      // Only server can write subscriptions
      allow write: if false;
    }

    // People collection (face recognition clusters)
    match /people/{personId} {
      allow read: if isAuthenticated() &&
                     isOwner(resource.data.userId);

      allow create: if isAuthenticated() &&
                       isOwner(request.resource.data.userId);

      allow update: if isAuthenticated() &&
                       isOwner(resource.data.userId) &&
                       // Users can only update name
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['name', 'updatedAt']);

      allow delete: if isAuthenticated() &&
                       isOwner(resource.data.userId);
    }

    // Referrals collection
    match /referrals/{referralId} {
      allow read: if isAuthenticated() && (
        resource.data.referrerUserId == request.auth.uid ||
        resource.data.refereeUserId == request.auth.uid
      );
      allow write: if false; // Only server can write
    }

    // Shared links collection (for public album sharing)
    match /shared/{shareToken} {
      // Share pages resolve tokens on the server. `read: if true` also
      // allowed LIST, i.e. enumerating every share token in the database.
      allow read: if false;
      allow write: if false; // Only server can manage
    }

    // Disk shares collection (for MySpace file/folder sharing)
    match /diskShares/{shareToken} {
      // Share pages resolve tokens on the server. `read: if true` also
      // allowed LIST, i.e. enumerating every share token in the database.
      allow read: if false;
      allow write: if false; // Only server can manage
    }

    // Disk share API keys (programmatic access). Holds the key HASH — never
    // exposed to clients. Read/written only by the server (admin SDK).
    match /diskShareKeys/{shareToken} {
      allow read: if false;
      allow write: if false;
    }

    // Disk share access records (tracks who accessed which shares)
    match /diskShareAccess/{accessId} {
      allow read: if isAuthenticated() && (
        resource.data.viewerUserId == request.auth.uid ||
        resource.data.ownerUserId == request.auth.uid
      );
      allow write: if false; // Only server can manage
    }

    // Disk files collection
    match /diskFiles/{fileId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow write: if false; // Only server can manage
    }

    // Folders collection
    match /folders/{folderId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow write: if false; // Only server can manage
    }
  }
}
